# Template for the real .env.production file, which lives only on the
# server (never committed — see .gitignore) and is read by
# docker-compose.prod.yml via `env_file:`. Copy this, fill in real values.

APP_NAME=Wallet
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Same-origin setup: this is the one public address Caddy serves everything
# from (frontend + /api). Until a domain exists (step 10.6), use the
# droplet's IP, e.g. http://161.35.104.97 — switch to https://yourdomain.tld
# once DNS + HTTPS are in place.
APP_URL=http://CHANGE_ME

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=personal_wallet_backend
DB_USERNAME=wallet
DB_PASSWORD=CHANGE_ME

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

# Same value as APP_URL (same-origin: frontend and API share one address).
FRONTEND_URL=http://CHANGE_ME
# Same host as APP_URL, without the scheme, e.g. 161.35.104.97 or yourdomain.tld
SANCTUM_STATEFUL_DOMAINS=CHANGE_ME

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
