# Template for the real mysql.env.production file, which lives only on the
# server (never committed) and is read by docker-compose.prod.yml. Copy
# this one directory ABOVE your personal-wallet-backend checkout (that's
# where docker-compose.prod.yml's ../mysql.env.production path expects to
# find it, alongside the personal-wallet-frontend checkout), fill in real
# generated passwords — must match the DB_USERNAME/DB_PASSWORD values in
# personal-wallet-backend/.env.production.

MYSQL_DATABASE=personal_wallet_backend
MYSQL_ROOT_PASSWORD=CHANGE_ME
MYSQL_USER=wallet
MYSQL_PASSWORD=CHANGE_ME
